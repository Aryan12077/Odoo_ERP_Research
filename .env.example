# ==========================================
# ODOO SOURCE CONNECTION SETTINGS
# ==========================================

# Odoo Base URL (No trailing slash)
ODOO_URL=https://your-instance.odoo.com

# Database Name
ODOO_DB=your_database

# Login Username / Email
ODOO_USERNAME=your_username@domain.com

# Password or API Key
ODOO_SECRET=your_api_key_or_password

# HTTP Request Timeout (seconds)
ODOO_TIMEOUT=30

# SSL Verification
ODOO_VERIFY_SSL=True

# ==========================================
# TARGET DATA WAREHOUSE (POSTGRESQL)
# ==========================================
TARGET_DB_HOST=localhost
TARGET_DB_PORT=5432
TARGET_DB_NAME=postgres
TARGET_DB_USER=postgres
TARGET_DB_PASSWORD=your_postgres_password
TARGET_DB_SCHEMA=EVA_BI


# ==========================================
# TARGET DATA WAREHOUSE (POSTGRESQL)
# ==========================================
TARGET_DB_HOST=localhost
TARGET_DB_PORT=5432
TARGET_DB_NAME=postgres
TARGET_DB_USER=postgres
TARGET_DB_PASSWORD=your_postgres_password
TARGET_DB_SCHEMA=EVA_BI